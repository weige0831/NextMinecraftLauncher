<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NML.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Variant-scoped design tokens (HMCL-style flat, opaque palette — no translucency,
                 no backdrop effects; the theme toggle just swaps solid colors). Accent/Success/
                 Danger are shared across variants (accent is user-overridable at runtime). -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- DARK (default): flat dark grays like HMCL's dark theme. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E1E22"/>
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF25252A"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#FF2A2A30"/>
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF303036"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE6E6E8"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA8A8AE"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF707078"/>
                    <!-- Nav: flat hover + a light selected fill (HMCL's selected item look). -->
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#FF33333A"/>
                    <SolidColorBrush x:Key="NavActiveBrush" Color="#FF3E3E46"/>
                    <SolidColorBrush x:Key="SmallButtonBgBrush" Color="#FF3A3A42"/>
                    <SolidColorBrush x:Key="SmallButtonHoverBgBrush" Color="#FF46464F"/>
                    <SolidColorBrush x:Key="DangerButtonBgBrush" Color="#FFB23B3B"/>
                </ResourceDictionary>
                <!-- LIGHT: flat light grays + dark text. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF3F3F5"/>
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFEAEAEC"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFF6F6F8"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1F1F23"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5A5A62"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8A8A92"/>
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#FFE2E2E6"/>
                    <SolidColorBrush x:Key="NavActiveBrush" Color="#FFD8D8DE"/>
                    <SolidColorBrush x:Key="SmallButtonBgBrush" Color="#FFE4E4E8"/>
                    <SolidColorBrush x:Key="SmallButtonHoverBgBrush" Color="#FFD6D6DC"/>
                    <SolidColorBrush x:Key="DangerButtonBgBrush" Color="#FFC03030"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Shared across variants (accent is overridden live by SettingsPageViewModel). -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3498DB"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF3F9E4F"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FFE04B4B"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Unified button styles (defined once, used everywhere) -->
        <StyleInclude Source="avares://NML.App/Styles/Theme.axaml"/>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtnClose /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
