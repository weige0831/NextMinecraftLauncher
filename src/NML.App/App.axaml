<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NML.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Windows 11 / Fluent 2 design tokens. Layered surfaces on a Mica-toned base,
                1px card strokes, and the Windows system accent (#0078D4). Light palette mirrors
                Win11 light (#F3F3F3 mica, white cards); dark mirrors Win11 dark (#202020 mica,
                #272727 cards). -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- DARK (default): Win11 dark-mode layers. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF202020"/>
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF272727"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#FF2B2B2B"/>
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF333333"/>
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#38FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC8C8C8"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="NavActiveBrush" Color="#FF3A3A3A"/>
                    <SolidColorBrush x:Key="SmallButtonBgBrush" Color="#FF3B3B3B"/>
                    <SolidColorBrush x:Key="SmallButtonHoverBgBrush" Color="#FF454545"/>
                    <SolidColorBrush x:Key="DangerButtonBgBrush" Color="#FFC42B1C"/>
                </ResourceDictionary>
                <!-- LIGHT: Win11 light-mode layers. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFEBEBEB"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFFBFBFB"/>
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#22000000"/>
                    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#2B000000"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5C5C5C"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8A8A8A"/>
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#12000000"/>
                    <SolidColorBrush x:Key="NavActiveBrush" Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="SmallButtonBgBrush" Color="#FFFDFDFD"/>
                    <SolidColorBrush x:Key="SmallButtonHoverBgBrush" Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="DangerButtonBgBrush" Color="#FFC42B1C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Windows system accent + semantic colors (accent overridable from Settings). -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1A86D9"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Unified button styles (defined once, used everywhere) -->
        <StyleInclude Source="avares://NML.App/Styles/Theme.axaml"/>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtnClose /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
