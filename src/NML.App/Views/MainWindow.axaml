<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:NML.App.Localization"
        xmlns:vm="using:NML.App.ViewModels"
        xmlns:v="using:NML.App.Views"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="680"
        x:Class="NML.App.Views.MainWindow"
        x:Name="Shell"
        Title="Next Minecraft Launcher"
        Width="1080" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding WindowFlowDirection}"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <!-- true when the nav item is the current page (drives the selected style). -->
        <v:NavActiveClassConverter x:Key="NavActiveConverter"/>
    </Window.Resources>

    <!-- Win11 NavigationView-style grid: labeled sidebar + content -->
    <Grid ColumnDefinitions="190,*">

        <!-- ===== SIDEBAR (Win11 nav: pill + left accent indicator on selection) ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}">
            <DockPanel>

                <!-- App identity -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14" Spacing="4">
                    <TextBlock Text="Minecraft" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Launcher" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Nav items -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pages}" Padding="10,0,10,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected indicator: vertical accent bar (Win11 style) -->
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,4"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource AccentBrush}">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{StaticResource NavActiveConverter}">
                                                <Binding Path="DataContext.CurrentPage" ElementName="Shell"/>
                                                <Binding/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                    </Border>

                                    <Button Grid.Column="1" Classes="nav" CornerRadius="4"
                                            Height="36" Margin="4,0,0,0"
                                            Padding="12,0"
                                            HorizontalContentAlignment="Left"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Command="{Binding #Shell.DataContext.NavigateToCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding LocalizedTitle}">
                                        <Classes.active>
                                            <MultiBinding Converter="{StaticResource NavActiveConverter}">
                                                <Binding Path="DataContext.CurrentPage" ElementName="Shell"/>
                                                <Binding/>
                                            </MultiBinding>
                                        </Classes.active>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding LocalizedTitle}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== CONTENT: 48px page header (title + accent underline) + page ===== -->
        <DockPanel Grid.Column="1" Background="{DynamicResource SurfaceBrush}">

            <Border DockPanel.Dock="Top" Height="48" Padding="28,0" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPage.Icon}" FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding CurrentPage.LocalizedTitle}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}"/>
        </DockPanel>
    </Grid>

    <Window.Styles>
        <!-- Nav item: subtle hover pill; selected = filled pill (accent indicator is separate). -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
        </Style>
        <!-- Standard textbox: Win11 bottom-stroke look -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- ComboBox: match textbox chrome -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
        </Style>
        <!-- Default Button (accent style, Win11 primary): only affects buttons that don't
             set their own background. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>
</Window>
