<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:NML.App.Localization"
        xmlns:vm="using:NML.App.ViewModels"
        xmlns:v="using:NML.App.Views"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="640"
        x:Class="NML.App.Views.MainWindow"
        x:Name="Shell"
        Title="Next Minecraft Launcher"
        Width="1080" Height="640" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding WindowFlowDirection}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource SurfaceAltBrush}">

    <Window.Resources>
        <!-- Enables the "selected nav item" visual: true when the current item equals the shell's
             CurrentPage. Bound to Button.Classes for the nav selected highlight. -->
        <v:NavActiveClassConverter x:Key="NavActiveConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Custom title bar (drag area + window controls) -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc 'app.title'}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Content="—" Width="40" Height="32" Classes="titleBtn"/>
                    <Button Click="Maximize_Click" Content="▢" Width="40" Height="32" Classes="titleBtn"/>
                    <Button Click="Close_Click" Content="✕" Width="40" Height="32" Classes="titleBtnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HMCL-style layout: labeled text sidebar + content area -->
        <Grid Grid.Row="1" ColumnDefinitions="150,*">

            <!-- Sidebar: icon + text label per page (HMCL's left nav), flat selected fill -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pages}" Padding="8,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="nav" CornerRadius="4"
                                        Width="134" Height="34"
                                        Padding="10,0" Margin="0,1"
                                        HorizontalAlignment="Left"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Command="{Binding #Shell.DataContext.NavigateToCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding LocalizedTitle}">
                                    <Classes.active>
                                        <MultiBinding Converter="{StaticResource NavActiveConverter}">
                                            <Binding Path="DataContext.CurrentPage" ElementName="Shell"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Classes.active>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LocalizedTitle}" FontSize="12.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Content area: the active page view (instant switch, no slide animation) -->
            <ContentControl Content="{Binding CurrentPage}" Grid.Column="1"/>
        </Grid>
    </Grid>

    <Window.Styles>
        <!-- Nav button base: flat, transparent until hover/selected. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <!-- Selected: flat light fill (HMCL look) + keep text color. -->
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
        </Style>
        <!-- Title-bar buttons. -->
        <Style Selector="Button.titleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="Button.titleBtnClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtnClose /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtnClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.titleBtnClose:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
</Window>
