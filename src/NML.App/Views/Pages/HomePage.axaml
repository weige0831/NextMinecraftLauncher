<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.HomePage">
    <Grid>

        <!-- ============================================================ -->
        <!-- HMCL-style single column:                                    -->
        <!--   top bar = instance selector + big LAUNCH on the same row   -->
        <!--   below   = compact toolbar, status, collapsible sections    -->
        <!-- ============================================================ -->
        <ScrollViewer Padding="28,20" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- ===== HERO: instance picker + primary LAUNCH (Win11 card, accent button) ===== -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
                        Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                      MinWidth="300" FontSize="14" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="★" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       IsVisible="{Binding IsFavorite}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding VersionId}" FontSize="11" Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding OfflineUsername}" Watermark="{loc:Loc 'home.offline_username'}"
                                         Width="180" FontSize="12"/>
                                <Button Content="{loc:Loc 'home.new_instance'}" Command="{Binding OpenNewInstanceWizardCommand}"
                                        Classes="small"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Win11 primary button: system accent, white label -->
                        <Button Grid.Column="1" Content="{loc:Loc 'home.launch'}" Command="{Binding LaunchCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                FontSize="15" FontWeight="SemiBold"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentHoverBrush}" BorderThickness="1"
                                Foreground="White"
                                CornerRadius="4" Width="160" Height="52"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Status line -->
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Progress (while busy) -->
                <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}"/>

                <!-- ===== LIVE CONSOLE (collapsed Expander; visible while busy) ===== -->
                <Expander Header="Console" IsExpanded="{Binding IsBusy}" FontSize="12"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding IsBusy}">
                    <StackPanel Spacing="4" Margin="0,6,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ConsoleSearchText}" Watermark="Search…" MinWidth="170" FontSize="11" Padding="6,4"/>
                            <CheckBox Content="Regex" IsChecked="{Binding IsConsoleRegexSearch}" FontSize="10" VerticalAlignment="Center" Margin="6,0"/>
                            <ComboBox ItemsSource="{Binding ConsoleSeverityOptions}" SelectedItem="{Binding ConsoleMinSeverity}"
                                      MinWidth="76" FontSize="10"/>
                            <Button Content="{loc:Loc 'home.export_log'}" Command="{Binding ExportConsoleLogCommand}"
                                    Classes="small" FontSize="10" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <ScrollViewer MaxHeight="220" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
                            <ItemsControl ItemsSource="{Binding ConsoleLines}" Padding="8,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                                   FontFamily="Cascadia Code,Consolas,monospace" FontSize="11" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Expander>

                <!-- ===== INSTANCE TOOLS (compact flat row) ===== -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'home.instance_tools'}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button Content="{loc:Loc 'instance.rename'}" Command="{Binding RenameInstanceCommand}" Classes="small" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{loc:Loc 'instance.clone'}" Command="{Binding CloneInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{loc:Loc 'instance.verify'}" Command="{Binding VerifyInstanceCommand}" Classes="small" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{loc:Loc 'instance.export_script'}" Command="{Binding ExportLaunchScriptCommand}" Classes="small" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{loc:Loc 'instance.export'}" Command="{Binding ExportInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{loc:Loc 'instance.open_dir'}" Command="{Binding OpenGameDirCommand}" Classes="small" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="{loc:Loc 'common.delete'}" Command="{Binding RemoveInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small danger" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding DiskUsageDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               IsVisible="{Binding DiskUsageDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- ===== MODPACK IMPORT + DEEP EXPORT (flat, side by side) ===== -->
                <Grid ColumnDefinitions="*,*" >
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,10,0">
                        <TextBlock Text="{loc:Loc 'modpack.import.title'}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding ImportModpackPath}" Watermark="{loc:Loc 'modpack.import.path_hint'}"
                                     MinWidth="220" FontSize="11" Padding="6,4"
                                     FontFamily="Cascadia Code,Consolas,monospace"/>
                            <Button Content="{loc:Loc 'common.browse'}" Command="{Binding BrowseModpackCommand}" Classes="small" FontSize="11"/>
                            <Button Content="{loc:Loc 'modpack.import.button'}" Command="{Binding ImportModpackCommand}" Classes="small" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{loc:Loc 'modpack.deep_title'}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <WrapPanel>
                            <CheckBox Content="{loc:Loc 'modpack.include_saves'}" IsChecked="{Binding ExportIncludeSaves}" FontSize="11" Margin="0,0,12,4"/>
                            <CheckBox Content="{loc:Loc 'modpack.include_screenshots'}" IsChecked="{Binding ExportIncludeScreenshots}" FontSize="11" Margin="0,0,12,4"/>
                            <CheckBox Content="{loc:Loc 'modpack.include_settings'}" IsChecked="{Binding ExportIncludeClientSettings}" FontSize="11"/>
                        </WrapPanel>
                        <Button Content="{loc:Loc 'modpack.deep_export'}" Command="{Binding ExportDeepInstanceCommand}"
                                CommandParameter="{Binding SelectedInstance}" Classes="small" FontSize="11" HorizontalAlignment="Left"
                                IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== ADVANCED OPTIONS (collapsible) ===== -->
                <Expander Header="{loc:Loc 'home.advanced'}" IsExpanded="False"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                    <StackPanel Spacing="12" Margin="0,10,0,0">

                        <!-- Memory -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{loc:Loc 'home.memory'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding MemoryPresets}" SelectedItem="{Binding SelectedMemoryPreset}" MinWidth="110" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Slider Minimum="512" Maximum="{Binding SliderMax}" Value="{Binding SelectedMaxMemory}"
                                        MinWidth="240" TickFrequency="512"/>
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedMaxMemory}"/> <Run Text=" MB"/>
                                </TextBlock>
                                <Button Content="{loc:Loc 'home.auto_tune'}" Command="{Binding ApplyJvmTuningCommand}" Classes="small" ToolTip.Tip="{loc:Loc 'home.auto_tune_hint'}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Window size -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{loc:Loc 'home.window_size'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SelectedWindowWidth}" MinWidth="64" FontSize="12" Padding="6,4"/>
                            <TextBlock Text="×" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SelectedWindowHeight}" MinWidth="64" FontSize="12" Padding="6,4"/>
                            <CheckBox Content="{loc:Loc 'home.fullscreen'}" IsChecked="{Binding LaunchFullscreen}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Version isolation -->
                        <StackPanel Spacing="4">
                            <CheckBox Content="{loc:Loc 'isolation.edit_label'}" IsChecked="{Binding SelectedInstanceIsIsolated}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <Button Content="{loc:Loc 'migration.button'}" Command="{Binding MigrateIsolationCommand}"
                                    Classes="small" HorizontalAlignment="Left" FontSize="11"/>
                        </StackPanel>

                        <!-- JVM + game args -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'home.jvm_args'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding CustomJvmArgs}" Watermark="-XX:+UseG1GC" MinWidth="360" FontSize="12"
                                     FontFamily="Cascadia Code,Consolas,monospace" Padding="6,4"/>
                            <TextBlock Text="{loc:Loc 'home.game_args'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBox Text="{Binding CustomGameArgs}" Watermark="--fullscreen" MinWidth="440" FontSize="12"
                                     FontFamily="Cascadia Code,Consolas,monospace" Padding="6,4"/>
                        </StackPanel>

                        <!-- Save button -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{loc:Loc 'instance.save'}" Command="{Binding SaveInstanceOptionsCommand}"
                                    IsEnabled="{Binding IsInstanceOptionsDirty}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" Padding="14,5" FontSize="12"/>
                            <TextBlock Text="{loc:Loc 'instance.unsaved'}" Foreground="#ffb74d" FontSize="12"
                                       VerticalAlignment="Center" IsVisible="{Binding IsInstanceOptionsDirty}"/>
                            <TextBlock Text="{loc:Loc 'instance.saved'}" Foreground="#81c784" FontSize="12"
                                       VerticalAlignment="Center" IsVisible="{Binding !IsInstanceOptionsDirty}"/>
                        </StackPanel>

                        <!-- Bulk tools + crash diagnostics -->
                        <WrapPanel>
                            <Button Content="{loc:Loc 'modpack.export_all'}" Command="{Binding ExportAllInstancesCommand}" Classes="small" Margin="0,0,6,4"/>
                            <Button Content="{loc:Loc 'modpack.delete_all'}" Command="{Binding DeleteAllInstancesCommand}" Classes="small danger" Margin="0,0,6,4"/>
                            <Button Content="{loc:Loc 'crash.submit.button'}" Command="{Binding SubmitCrashToAiCommand}" Classes="small" Margin="0,0,6,4"
                                    IsEnabled="{Binding !IsBusy}"/>
                        </WrapPanel>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- NEW INSTANCE WIZARD MODAL (overlay)                          -->
        <!-- ============================================================ -->
        <Border Background="#00000099" IsVisible="{Binding ShowNewInstanceWizard}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="24" MaxWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc 'home.new_instance'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc 'home.instance_name'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBox Text="{Binding NewInstanceName}" Watermark="{loc:Loc 'home.instance_name_hint'}" MinWidth="300"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc 'home.version'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding NewInstanceVersion}"
                                  MinWidth="300" MaxDropDownHeight="300"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc 'home.modloader'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding ModloaderChoices}" SelectedItem="{Binding NewInstanceModloader}"
                                  MinWidth="200"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc 'home.memory'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <Slider Minimum="1024" Maximum="32768" Value="{Binding NewInstanceMemory}"
                                TickFrequency="512" IsSnapToTickEnabled="True" MinWidth="340"/>
                        <TextBlock Text="{Binding NewInstanceMemory}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                    </StackPanel>
                    <CheckBox Content="{loc:Loc 'isolation.wizard_label'}" IsChecked="{Binding NewInstanceIsIsolated}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{loc:Loc 'common.cancel'}" Command="{Binding CancelNewInstanceWizardCommand}" Classes="small"/>
                        <Button Content="{loc:Loc 'home.create_install'}" Command="{Binding CreateNewInstanceCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="White" Padding="14,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
